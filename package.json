{
  "name": "duo-arena",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Online 2-player mini games (three.js web + Android via Capacitor)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "build:offline": "vite build --config client/vite.config.js --mode offline --outDir dist-offline"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "planck": "^1.4.2",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
